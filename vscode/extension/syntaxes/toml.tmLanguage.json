{
    "name": "TOML",
    "scopeName": "source.toml",
    "patterns": [
        { "include": "#comment" },
        { "include": "#table" },
        { "include": "#key" },
        { "include": "#value" }
    ],
    "repository": {
        "comment": {
            "name": "comment.line.number-sign.toml",
            "match": "#.*$"
        },
        "table": {
            "match": "^\\s*(\\[\\[?)([^\\]#]*)(\\]\\]?)",
            "captures": {
                "1": { "name": "punctuation.definition.table.toml" },
                "2": { "name": "entity.name.tag.table.toml" },
                "3": { "name": "punctuation.definition.table.toml" }
            }
        },
        "key": {
            "match": "((?:[A-Za-z0-9_-]+|\"[^\"]*\"|'[^']*')(?:\\s*\\.\\s*(?:[A-Za-z0-9_-]+|\"[^\"]*\"|'[^']*'))*)\\s*(=)",
            "captures": {
                "1": { "name": "support.type.property-name.toml" },
                "2": { "name": "keyword.operator.assignment.toml" }
            }
        },
        "value": {
            "patterns": [
                { "include": "#string" },
                { "include": "#date" },
                { "include": "#number" },
                { "include": "#boolean" },
                { "include": "#array" },
                { "include": "#inline-table" }
            ]
        },
        "string": {
            "patterns": [
                {
                    "name": "string.quoted.triple.basic.toml",
                    "begin": "\"\"\"",
                    "end": "\"\"\"",
                    "patterns": [{ "include": "#escape" }]
                },
                {
                    "name": "string.quoted.triple.literal.toml",
                    "begin": "'''",
                    "end": "'''"
                },
                {
                    "name": "string.quoted.double.toml",
                    "begin": "\"",
                    "end": "\"|$",
                    "patterns": [{ "include": "#escape" }]
                },
                {
                    "name": "string.quoted.single.toml",
                    "begin": "'",
                    "end": "'|$"
                }
            ]
        },
        "escape": {
            "name": "constant.character.escape.toml",
            "match": "\\\\."
        },
        "date": {
            "name": "constant.numeric.date.toml",
            "match": "\\b\\d{4}-\\d{2}-\\d{2}(?:[Tt ]\\d{2}:\\d{2}(?::\\d{2}(?:\\.\\d+)?)?(?:[Zz]|[+-]\\d{2}:\\d{2})?)?\\b|\\b\\d{2}:\\d{2}(?::\\d{2}(?:\\.\\d+)?)?\\b"
        },
        "number": {
            "name": "constant.numeric.toml",
            "match": "(?<![\\w.])[+-]?(?:0x[0-9A-Fa-f_]+|0o[0-7_]+|0b[01_]+|\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d[\\d_]*)?|inf|nan)(?![\\w.])"
        },
        "boolean": {
            "name": "constant.language.boolean.toml",
            "match": "\\b(?:true|false)\\b"
        },
        "array": {
            "begin": "\\[",
            "end": "\\]",
            "patterns": [
                { "include": "#comment" },
                { "include": "#value" }
            ]
        },
        "inline-table": {
            "begin": "\\{",
            "end": "\\}",
            "patterns": [
                { "include": "#comment" },
                { "include": "#key" },
                { "include": "#value" }
            ]
        }
    }
}
